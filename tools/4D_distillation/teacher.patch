+"""Stable Track4World feature contract for offline policy distillation.
+
+The adapter observes existing model internals with forward hooks.  Its default
+teacher-only path avoids materializing public inference outputs while preserving
+the ``track4world_da3_v1`` feature contract.  The legacy path remains available
+for numerical validation.
+"""
+
+from __future__ import annotations
+
+import warnings
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+import torch.nn.functional as F
+
+
+FEATURE_API_VERSION = "track4world_da3_v1"
+FEATURE_BLOCK_DIMS = {
+    "geometry": 1024,
+    "motion_2d": 128,
+    "motion_3d": 256,
+    "camera": 18,
+    "visibility": 4,
+}
+FEATURE_DIM = sum(FEATURE_BLOCK_DIMS.values())
+
+
+class TeacherCompileFallbackError(RuntimeError):
+    """Signal that the complete teacher call must be replayed eagerly."""
+
+
+def _clone_compiled_output(value):
+    if isinstance(value, torch.Tensor):
+        return value.clone()
+    if isinstance(value, tuple):
+        return tuple(_clone_compiled_output(item) for item in value)
+    if isinstance(value, list):
+        return [_clone_compiled_output(item) for item in value]
+    if isinstance(value, dict):
+        return {key: _clone_compiled_output(item) for key, item in value.items()}
+    return value
+
+
+class CompileFallbackModule(torch.nn.Module):
+    """Use torch.compile when available and permanently fall back on failure."""
+
+    def __init__(self, module: torch.nn.Module, *, mode: str) -> None:
+        super().__init__()
+        self.eager = module
+        self.mode = str(mode)
+        self.compile_error: str | None = None
+        try:
+            self.compiled = torch.compile(
+                module,
+                mode=self.mode,
+                fullgraph=False,
+                dynamic=False,
+            )
+        except Exception as error:
+            self.compiled = None
+            self.compile_error = f"{type(error).__name__}: {error}"
+
+    @property
+    def compile_active(self) -> bool:
+        return self.compiled is not None
+
+    def forward(self, *args: Any, **kwargs: Any):
+        if self.compiled is None:
+            return self.eager(*args, **kwargs)
+        try:
+            # reduce-overhead may use CUDA Graphs whose output buffers are
+            # reused at the next recurrent call.  The caller keeps these
+            # hidden states alive, so detach them from graph-owned storage.
+            return _clone_compiled_output(self.compiled(*args, **kwargs))
+        except Exception as error:
+            self.compile_error = f"{type(error).__name__}: {error}"
+            self.compiled = None
+            warnings.warn(
+                "Track4World motion compile failed; using eager for all "
+                f"subsequent calls ({self.compile_error}).",
+                RuntimeWarning,
+            )
+            raise TeacherCompileFallbackError(self.compile_error) from error
+
+
+def enable_teacher_motion_compile(
+    model: torch.nn.Module,
+    *,
+    mode: str = "reduce-overhead",
+) -> dict[str, bool]:
+    """Compile fixed-shape recurrent motion cores with per-module fallback."""
+    status = {}
+    for name in ("flow_update_block", "flow3d_head"):
+        module = getattr(model, name)
+        if isinstance(module, CompileFallbackModule):
+            status[name] = module.compile_active
+            continue
+        wrapper = CompileFallbackModule(module, mode=mode)
+        setattr(model, name, wrapper)
+        status[name] = wrapper.compile_active
+    model._teacher_motion_compile_mode = str(mode)
+    return status
+
+
+def _pool_channels(tensor: torch.Tensor, channels: int) -> torch.Tensor:
+    value = tensor.detach().float()
+    channel_axes = [axis for axis, size in enumerate(value.shape) if size == channels]
+    if not channel_axes:
+        raise ValueError(
+            f"Cannot find channel dimension {channels} in tensor {tuple(value.shape)}."
+        )
+    channel_axis = channel_axes[-1] if value.shape[-1] == channels else channel_axes[0]
+    value = value.movedim(channel_axis, -1)
+    return value.reshape(-1, channels).mean(dim=0)
+
+
+def _pool_channels_batched(
+    tensor: torch.Tensor,
+    channels: int,
+    batch_size: int,
+    frames: int,
+) -> torch.Tensor:
+    """Pool spatial/token dimensions while preserving independent clips."""
+    value = tensor.detach().float()
+    channel_axes = [axis for axis, size in enumerate(value.shape) if size == channels]
+    if not channel_axes:
+        raise ValueError(
+            f"Cannot find channel dimension {channels} in tensor {tuple(value.shape)}."
+        )
+    channel_axis = channel_axes[-1] if value.shape[-1] == channels else channel_axes[0]
+    value = value.movedim(channel_axis, -1)
+    if int(value.shape[0]) == batch_size:
+        return value.reshape(batch_size, -1, channels).mean(dim=1)
+    if int(value.shape[0]) == batch_size * frames:
+        return value.reshape(batch_size, frames, -1, channels).mean(dim=(1, 2))
+    if batch_size == 1:
+        return value.reshape(1, -1, channels).mean(dim=1)
+    raise ValueError(
+        "Cannot recover teacher batch dimension from tensor "
+        f"{tuple(tensor.shape)} for B={batch_size}, T={frames}."
+    )
+
+
+def blockwise_l2_normalize(blocks: list[torch.Tensor]) -> torch.Tensor:
+    normalized = [
+        F.normalize(block.float(), dim=0, eps=1.0e-6)
+        for block in blocks
+    ]
+    return torch.cat(normalized, dim=0)
+
+
+def camera_pose_statistics(camera_poses: torch.Tensor) -> torch.Tensor:
+    poses = camera_poses.detach().float()
+    while poses.ndim > 3 and int(poses.shape[0]) == 1:
+        poses = poses[0]
+    if poses.ndim != 3 or tuple(poses.shape[-2:]) not in {(4, 4), (3, 4)}:
+        raise ValueError(f"Unexpected camera pose shape: {tuple(camera_poses.shape)}")
+    if tuple(poses.shape[-2:]) == (3, 4):
+        bottom = torch.zeros(
+            (int(poses.shape[0]), 1, 4), device=poses.device, dtype=poses.dtype
+        )
+        bottom[..., 0, 3] = 1.0
+        poses = torch.cat([poses, bottom], dim=-2)
+    relative = torch.linalg.inv(poses[:1]) @ poses
+    rotation_mean = relative[:, :3, :3].mean(dim=0).reshape(-1)
+    translation = relative[:, :3, 3]
+    translation_mean = translation.mean(dim=0)
+    translation_std = translation.std(dim=0, unbiased=False)
+    translation_final = translation[-1]
+    stats = torch.cat(
+        [rotation_mean, translation_mean, translation_std, translation_final], dim=0
+    )
+    if tuple(stats.shape) != (18,):
+        raise AssertionError(f"Camera statistics shape changed: {tuple(stats.shape)}")
+    return stats
+
+
+def visibility_statistics(
+    mask: torch.Tensor,
+    visconf: torch.Tensor,
+) -> torch.Tensor:
+    mask_value = mask.detach().float().mean()
+    values = visconf.detach().float()
+    if int(values.shape[-1]) == 2:
+        values = values.reshape(-1, 2)
+    elif values.ndim >= 3 and int(values.shape[-3]) == 2:
+        values = values.movedim(-3, -1).reshape(-1, 2)
+    else:
+        raise ValueError(f"Unexpected visibility tensor shape: {tuple(visconf.shape)}")
+    probabilities = torch.sigmoid(values)
+    visible = probabilities[:, 0]
+    confidence = probabilities[:, 1]
+    return torch.stack(
+        [
+            mask_value,
+            visible.mean(),
+            confidence.mean(),
+            confidence.std(unbiased=False),
+        ]
+    )
+
+
+@dataclass
+class Track4WorldFeatureResult:
+    teacher_feature: torch.Tensor
+    teacher_valid: bool
+    blocks: dict[str, torch.Tensor]
+
+
+class Track4WorldDistillationAdapter:
+    """Extract the public ``track4world_da3_v1`` 1430-D feature."""
+
+    feature_api_version = FEATURE_API_VERSION
+    feature_dim = FEATURE_DIM
+
+    def __init__(
+        self,
+        model: torch.nn.Module,
+        *,
+        iters: int = 4,
+        use_fast_path: bool = True,
+        motion_chunk_size: int = 12,
+    ) -> None:
+        self.model = model
+        self.iters = int(iters)
+        if self.iters <= 0:
+            raise ValueError(f"iters must be positive, got {self.iters}.")
+        self.use_fast_path = bool(use_fast_path)
+        self.motion_chunk_size = int(motion_chunk_size)
+        if self.motion_chunk_size <= 0:
+            raise ValueError("motion_chunk_size must be positive.")
+        self._geometry: list[torch.Tensor] = []
+        self._motion_2d: list[torch.Tensor] = []
+        self._motion_3d: list[torch.Tensor] = []
+        self._motion_2d_call_count = 0
+        self._motion_3d_call_count = 0
+        self._active_batch_size = 1
+        self._active_frames = 1
+        self._motion_2d_by_sample: list[list[torch.Tensor]] = [[]]
+        self._motion_3d_by_sample: list[list[torch.Tensor]] = [[]]
+        self._handles = [
+            model.dot_fc2.register_forward_pre_hook(self._capture_geometry),
+            model.flow_update_block.register_forward_hook(self._capture_motion_2d),
+            model.flow3d_head.register_forward_hook(self._capture_motion_3d),
+        ]
+
+    def close(self) -> None:
+        for handle in self._handles:
+            handle.remove()
+        self._handles.clear()
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, exc_type, exc, tb):
+        self.close()
+
+    def _capture_geometry(self, _module, args) -> None:
+        self._geometry.append(
+            _pool_channels_batched(
+                args[0],
+                FEATURE_BLOCK_DIMS["geometry"],
+                self._active_batch_size,
+                self._active_frames,
+            )
+        )
+
+    def _capture_motion_2d(self, _module, _args, output) -> None:
+        self._motion_2d_call_count += 1
+        if self._motion_2d_call_count % self.iters == 0:
+            sample_index = int(getattr(self.model, "_teacher_batch_index", 0))
+            for pooled in self._pool_virtual_motion_chunks(
+                output, FEATURE_BLOCK_DIMS["motion_2d"]
+            ):
+                self._motion_2d.append(pooled)
+                self._motion_2d_by_sample[sample_index].append(pooled)
+
+    def _capture_motion_3d(self, _module, _args, output) -> None:
+        self._motion_3d_call_count += 1
+        if self._motion_3d_call_count % self.iters != 0:
+            return
+        feature = output[1] if isinstance(output, (tuple, list)) else output
+        sample_index = int(getattr(self.model, "_teacher_batch_index", 0))
+        for pooled in self._pool_virtual_motion_chunks(
+            feature, FEATURE_BLOCK_DIMS["motion_3d"]
+        ):
+            self._motion_3d.append(pooled)
+            self._motion_3d_by_sample[sample_index].append(pooled)
+
+    def _pool_virtual_motion_chunks(
+        self, tensor: torch.Tensor, channels: int
+    ) -> list[torch.Tensor]:
+        sizes = getattr(self.model, "_teacher_motion_virtual_chunk_sizes", None)
+        if not sizes:
+            return [_pool_channels(tensor, channels)]
+        if sum(int(size) for size in sizes) != int(tensor.shape[0]):
+            raise ValueError(
+                "Virtual motion chunks do not cover the refinement batch: "
+                f"sizes={sizes}, tensor={tuple(tensor.shape)}."
+            )
+        pooled = []
+        start = 0
+        for size in sizes:
+            end = start + int(size)
+            pooled.append(_pool_channels(tensor[start:end], channels))
+            start = end
+        return pooled
+
+    def _reset(self, *, batch_size: int, frames: int) -> None:
+        self._geometry.clear()
+        self._motion_2d.clear()
+        self._motion_3d.clear()
+        self._motion_2d_call_count = 0
+        self._motion_3d_call_count = 0
+        self._active_batch_size = int(batch_size)
+        self._active_frames = int(frames)
+        self._motion_2d_by_sample = [[] for _ in range(batch_size)]
+        self._motion_3d_by_sample = [[] for _ in range(batch_size)]
+        self.model._teacher_batch_index = 0
+
+    def prepare_da3_local_prefix(
+        self,
+        images: torch.Tensor,
+        *,
+        frame_chunk_size: int = 32,
+        offload_to_cpu: bool = True,
+    ) -> torch.Tensor:
+        """Build an episode-local prefix tensor without crossing frame boundaries."""
+        if images.ndim != 5 or int(images.shape[0]) != 1 or int(images.shape[2]) != 3:
+            raise ValueError(
+                "DA3 episode prefix expects [1,T,3,H,W], got "
+                f"{tuple(images.shape)}."
+            )
+        frame_chunk_size = int(frame_chunk_size)
+        if frame_chunk_size <= 0:
+            raise ValueError("frame_chunk_size must be positive.")
+        prefixes = []
+        for start in range(0, int(images.shape[1]), frame_chunk_size):
+            chunk = images[:, start : start + frame_chunk_size]
+            with torch.inference_mode(), torch.autocast(
+                device_type=chunk.device.type, dtype=torch.float16
+            ):
+                prefix = self.model.prepare_da3_local_prefix(chunk)
+            prefix = prefix.detach()
+            if offload_to_cpu:
+                prefix = prefix.to(device="cpu")
+            prefixes.append(prefix)
+        return torch.cat(prefixes, dim=1)
+
+    def extract(self, images: torch.Tensor, **infer_kwargs: Any) -> Track4WorldFeatureResult:
+        """Extract a teacher feature using the configured inference path."""
+        if images.ndim != 5 or int(images.shape[0]) != 1:
+            raise ValueError(
+                "extract expects exactly one clip; use extract_batch for B > 1."
+            )
+        return self._extract_batch(
+            images,
+            teacher_only=self.use_fast_path,
+            infer_kwargs=infer_kwargs,
+        )[0]
+
+    def extract_batch(
+        self, images: torch.Tensor, **infer_kwargs: Any
+    ) -> list[Track4WorldFeatureResult]:
+        """Extract independent per-window features from a real batch."""
+        if not self.use_fast_path and int(images.shape[0]) != 1:
+            raise ValueError("Batched extraction requires the teacher-only fast path.")
+        return self._extract_batch(
+            images,
+            teacher_only=self.use_fast_path,
+            infer_kwargs=infer_kwargs,
+        )
+
+    def extract_legacy(
+        self, images: torch.Tensor, **infer_kwargs: Any
+    ) -> Track4WorldFeatureResult:
+        """Run the original public inference graph for equivalence checks."""
+        if images.ndim != 5 or int(images.shape[0]) != 1:
+            raise ValueError("Legacy teacher extraction only supports B=1.")
+        return self._extract_batch(
+            images, teacher_only=False, infer_kwargs=infer_kwargs
+        )[0]
+
+    def _extract_batch(
+        self,
+        images: torch.Tensor,
+        *,
+        teacher_only: bool,
+        infer_kwargs: dict[str, Any],
+    ) -> list[Track4WorldFeatureResult]:
+        if images.ndim != 5 or int(images.shape[0]) < 1 or int(images.shape[2]) != 3:
+            raise ValueError(
+                "Track4World distillation expects clips [B,T,3,H,W], got "
+                f"{tuple(images.shape)}."
+            )
+        batch_size, frames = int(images.shape[0]), int(images.shape[1])
+        if "teacher_only" in infer_kwargs:
+            raise ValueError("teacher_only is controlled by the distillation adapter.")
+        self._reset(batch_size=batch_size, frames=frames)
+        call_kwargs = {
+            "iters": self.iters,
+            "sw": None,
+            "is_training": False,
+            "tracking3d": True,
+            "apply_mask": False,
+            "force_projection": True,
+            "teacher_only": teacher_only,
+            "motion_chunk_size": self.motion_chunk_size,
+            **infer_kwargs,
+        }
+        output = None
+        for _attempt in range(3):
+            try:
+                output = self.model.infer_pair(images, **call_kwargs)
+                break
+            except TeacherCompileFallbackError:
+                # A module may fail after earlier compiled recurrent calls have
+                # produced CUDA-Graph-owned tensors.  Restart from raw frames so
+                # eager never consumes potentially overwritten intermediate state.
+                self._reset(batch_size=batch_size, frames=frames)
+        if output is None:
+            raise RuntimeError("Teacher compile fallback did not converge to eager.")
+        if not self._geometry or not self._motion_2d or not self._motion_3d:
+            raise RuntimeError(
+                "Track4World hooks did not observe all required feature blocks."
+            )
+        if (
+            self._motion_2d_call_count % self.iters != 0
+            or self._motion_3d_call_count % self.iters != 0
+        ):
+            raise RuntimeError(
+                "Track4World refinement hook count is not divisible by iters."
+            )
+        if not self._motion_2d or not self._motion_3d:
+            raise RuntimeError("No final Track4World refinement features were captured.")
+        geometry = torch.stack(self._geometry).mean(dim=0)
+        if teacher_only:
+            camera_poses = output["camera_poses"]
+            mask = output["mask"]
+            visconf_maps_e = output["visconf_maps_e"]
+        else:
+            camera_poses = output[0]["camera_poses"]
+            mask = output[0]["mask"]
+            visconf_maps_e = output[1]["visconf_maps_e"]
+        if camera_poses.ndim == 3:
+            camera_poses = camera_poses.unsqueeze(0)
+            mask = mask.unsqueeze(0) if mask.ndim == 3 else mask
+            visconf_maps_e = (
+                visconf_maps_e.unsqueeze(0)
+                if visconf_maps_e.ndim == 4
+                else visconf_maps_e
+            )
+        results = []
+        for sample_index in range(batch_size):
+            if not self._motion_2d_by_sample[sample_index]:
+                raise RuntimeError(
+                    f"No final 2D motion feature for batch item {sample_index}."
+                )
+            if not self._motion_3d_by_sample[sample_index]:
+                raise RuntimeError(
+                    f"No final 3D motion feature for batch item {sample_index}."
+                )
+            blocks = {
+                "geometry": geometry[sample_index],
+                "motion_2d": torch.stack(
+                    self._motion_2d_by_sample[sample_index]
+                ).mean(dim=0),
+                "motion_3d": torch.stack(
+                    self._motion_3d_by_sample[sample_index]
+                ).mean(dim=0),
+                "camera": camera_pose_statistics(camera_poses[sample_index]),
+                "visibility": visibility_statistics(
+                    mask[sample_index], visconf_maps_e[sample_index]
+                ),
+            }
+            for name, expected_dim in FEATURE_BLOCK_DIMS.items():
+                if tuple(blocks[name].shape) != (expected_dim,):
+                    raise ValueError(
+                        f"Track4World block {name!r} expected {expected_dim}, "
+                        f"got {tuple(blocks[name].shape)}."
+                    )
+            teacher_feature = blockwise_l2_normalize(list(blocks.values()))
+            valid = bool(
+                tuple(teacher_feature.shape) == (FEATURE_DIM,)
+                and torch.isfinite(teacher_feature).all().item()
+            )
+            results.append(
+                Track4WorldFeatureResult(
+                    teacher_feature=teacher_feature,
+                    teacher_valid=valid,
+                    blocks=blocks,
+                )
+            )
+        return results
